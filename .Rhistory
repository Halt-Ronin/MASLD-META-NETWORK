##############################################
# Generic  functions
##############################################
convert_orthologs <- function(source_species = "human",
target_species = "mouse",
gene_list,
orthology_type = c("all", "one2one", "best")) {
orthology_type <- match.arg(orthology_type)
# Select source mart
source_mart <- switch(source_species,
"human" = human_mart,
"mouse" = mouse_mart,
"rat"   = rat_mart,
"zebra" = zebra_mart,
stop("nknown source species")
)
# Select target mart
target_mart <- switch(target_species,
"human" = human_mart,
"mouse" = mouse_mart,
"rat"   = rat_mart,
"zebra" = zebra_mart,
stop(" Unknown target species")
)
# Define attribute names for each species
source_attr <- switch(source_species,
"human" = "hgnc_symbol",
"mouse" = "mgi_symbol",
"rat"   = "rgd_symbol",
"zebra" = "zfin_id_symbol"
)
# pick the target-side symbol attribute
target_symbol <- switch(target_species,
"human" = "hgnc_symbol",
"mouse" = "mgi_symbol",
"rat"   = "rgd_symbol",
"zebra" = "zfin_id_symbol"
)
# species-specific homolog attribute (lives on SOURCE side)
prefix <- switch(target_species,
"human" = "hsapiens",
"mouse" = "mmusculus",
"rat"   = "rnorvegicus",
"zebra" = "drerio"
)
orthology_attr <- paste0(prefix, "_homolog_orthology_type")
message(paste0("🔄 Converting from ", source_species, " to ", target_species, " via Ensembl..."))
##############################################
# Query Ensembl BioMart
##############################################
# getLDS: only homologs-page attrs on source side
res <- biomaRt::getLDS(
attributes  = orthology_attr,                 # source side (Homologs page)
filters     = source_attr,                    # e.g., "hgnc_symbol"
values      = gene_list,
mart        = source_mart,
attributesL = c(target_symbol, "ensembl_gene_id"),  # target side
martL       = target_mart
)
colnames(res) <- c(
paste0(source_species, "_gene"),
paste0(target_species, "_gene"),
paste0(target_species, "_ensembl"),
"orthology_type"
)
##############################################
# Filter by orthology type
##############################################
if (orthology_type == "one2one") {
res <- res[res$orthology_type == "ortholog_one2one", ]
} else if (orthology_type == "best") {
res <- res %>%
group_by(.data[[paste0(source_species, "_gene")]]) %>%
slice_head(n = 1) %>%
ungroup()
}
res <- unique(res)
return(res)
}
