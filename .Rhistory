##############################################
# Query Ensembl BioMart
##############################################
# getLDS: only homologs-page attrs on source side
res <- biomaRt::getLDS(
attributes  = orthology_attr,                 # source side (Homologs page)
filters     = source_attr,                    # e.g., "hgnc_symbol"
