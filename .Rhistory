# add this line for source-side orthology type:
orthology_attr <- switch(target_species,
"human" = "hsapiens_homolog_orthology_type",
"mouse" = "mmusculus_homolog_orthology_type",
"rat"   = "rnorvegicus_homolog_orthology_type",
"zebra" = "drerio_homolog_orthology_type"
)
message(paste0("🔄 Converting from ", source_species, " to ", target_species, " via Ensembl..."))
##############################################
# Query Ensembl BioMart
##############################################
res <- getLDS(
attributes  = c(source_attr, orthology_attr),  # e.g., "mmusculus_homolog_orthology_type"
filters     = source_attr,
values      = gene_list,
mart        = source_mart,
attributesL = target_attr,  # no "orthology_type" here
martL       = target_mart
)
colnames(res) <- c(
paste0(source_species, "_gene"),
paste0(target_species, "_gene"),
paste0(target_species, "_ensembl"),
"orthology_type"
)
##############################################
# Filter by orthology type
##############################################
if (orthology_type == "one2one") {
res <- res[res$orthology_type == "ortholog_one2one", ]
} else if (orthology_type == "best") {
res <- res %>%
group_by(.data[[paste0(source_species, "_gene")]]) %>%
slice_head(n = 1) %>%
ungroup()
}
res <- unique(res)
return(res)
}
