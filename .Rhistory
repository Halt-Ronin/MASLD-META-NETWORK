"human" = human_mart,
"mouse" = mouse_mart,
"rat"   = rat_mart,
"zebra" = zebra_mart,
stop(" Unknown target species")
)
# Define attribute names for each species
source_attr <- switch(source_species,
"human" = "hgnc_symbol",
"mouse" = "mgi_symbol",
"rat"   = "rgd_symbol",
"zebra" = "zfin_id_symbol"
)
# pick the target-side symbol attribute
target_symbol <- switch(target_species,
"human" = "hgnc_symbol",
"mouse" = "mgi_symbol",
"rat"   = "rgd_symbol",
"zebra" = "zfin_id_symbol"
)
# species-specific homolog attribute (lives on SOURCE side)
prefix <- switch(target_species,
"human" = "hsapiens",
"mouse" = "mmusculus",
"rat"   = "rnorvegicus",
"zebra" = "drerio"
)
orthology_attr <- paste0(prefix, "_homolog_orthology_type")
