genesets <- c("H","C1","C2","C3","C4","C5","C6","C7","C8")
for (i in genesets){
msig_hallmark <- msigdbr(species = "Homo sapiens", category = i)
hallmark_list <- msig_hallmark[, c("gs_name", "gene_symbol")]
ora_hallmark <- enricher(gene = female$Gene,
TERM2GENE = hallmark_list,
pAdjustMethod = "BH",
qvalueCutoff = 0.05)
data_framed_ora <- as.data.frame(ora_hallmark)
if (nrow(data_framed_ora) > 0){
write_xlsx(data_framed_ora, paste("gender/female_NAS_overview_msigdb_",i,"_downregulated.xlsx", sep=""))
p <- barplot(ora_hallmark,
drop = TRUE,
showCategory = 10,
title = paste("MSigDB = ",i, " (NAS)", sep = ""),
font.size = 10)
# Save as 600 DPI PNG
ggsave(paste("gender/female_NAS_ORA_MSigDB_",i,"_downregulated.png", sep=""),
plot = p,
width = 8, height = 6, dpi = 600, units = "in")
}
}
